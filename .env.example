SECRET_KEY=replace-with-long-random-secret
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-unique-password-at-least-16-characters
DATABASE_PATH=instance/mops.sqlite3
UPLOAD_FOLDER=uploads
PAYMENT_CARD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional: Ukraine dispatch manager username (without @). Default: barujka032.
UKRAINE_MANAGER_USERNAME=barujka032
# Optional on Render: uses RENDER_EXTERNAL_URL automatically. For other hosts set HTTPS URL.
TELEGRAM_WEBAPP_URL=

# Discord bot token, NOT a channel webhook URL or personal account token.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: limit the feed to this webhook ID in the selected channel.
DISCORD_WEBHOOK_ID=

# Persistent database (required on Render). Copy the complete provider connection string.
DATABASE_URL=
# Email codes over HTTPS. EMAIL_PROVIDER: resend or brevo.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mops Parcel
# Keep enabled for automatic Telegram retries while the web service is running.
NOTIFICATION_WORKER=true

# Private Telegram channel for photo reports. Add the bot as an admin with posting rights.
# Leave empty to keep all reports in the database.
TELEGRAM_ARCHIVE_CHAT_ID=
# Periodic retries; event-driven work starts immediately. Minimum 600 seconds.
BACKGROUND_CHECK_SECONDS=3600
